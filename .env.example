# ==============================================================================
# CIRRUS CRM BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection URL (PostgreSQL 15+)
# For local Docker: postgresql://postgres:postgres@localhost:5432/crm?sslmode=disable
# For Cloud (Neon / Render / Supabase): postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_d4aiPpZyrU5f@ep-sparkling-shadow-aymeokes-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=change_this_to_a_long_cryptographically_secure_random_string
JWT_EXPIRES_IN=8h

# Server Configuration
PORT=4000
NODE_ENV=development

# Task Reminders Cron
# Standard cron expression: "0 * * * *" runs hourly
REMINDER_CRON_SCHEDULE=0 * * * *
DISABLE_REMINDER_CRON=false
